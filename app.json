{
  "expo": {
    "name": "DropMic",
    "slug": "MicDrop",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "micdrop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.prentisswhitley.dropmic",
      "buildNumber": "5",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:thedropmic.com"
      ]
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#73C5F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://thedropmic.com",
          "headOrigin": "https://thedropmic.com"
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow DropMic to access your microphone for speaking practice.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "909aba35-5e29-4a64-a0bd-c995da59702a"
      }
    },
    "owner": "roguescr1be"
  }
}
